  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@iconify-json/fa": "^1.1.0",
    "@iconify-json/mdi": "^1.1.0",
    "@types/node": "^20.11.24",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.49.0",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vue/test-utils": "^2.4.5",
    "@vue/tsconfig": "^0.5.1",
    "eslint": "^9.39.1",
    "eslint-plugin-vue": "^10.6.2",
    "prettier": "^3.2.5",
    "sass-embedded": "^1.96.0",
    "terser": "^5.44.1",
